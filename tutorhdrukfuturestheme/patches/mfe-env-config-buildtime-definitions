
// Read the persisted theme from the base-domain `theme` cookie (shared across
// the LMS, MFEs and marketing site), falling back to the OS preference.
const getActiveThemeFromCookie = () => {
  const match = document.cookie.match(/(?:^|; )theme=(dark|light)/);
  if (match) {
    return match[1];
  }
  return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
};

// FOUC guard: apply the persisted/preferred theme synchronously as this config
// module is evaluated (before React renders), so content paints dark from the
// first frame rather than flashing light then switching in an effect.
(function applyInitialTheme() {
  try {
    document.documentElement.classList.toggle('dark', getActiveThemeFromCookie() === 'dark');
  } catch (e) {
    // cookie / matchMedia unavailable - ignore.
  }
})();
